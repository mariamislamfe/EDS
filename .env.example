# ---------- Neon database (Console → your project → Connect) ----------
# Pooled connection string (host contains "-pooler") — used by the website
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) connection string — used by migrations/import scripts
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---------- Neon Object Storage (optional — for uploading images from the dashboard) ----------
# Console → Object storage → create bucket "media" with access "public_read",
# then create a credential with storage:read + storage:write
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=media

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ---------- Kit assistant (the "Check my list" chat) ----------
# Claude API key from console.anthropic.com. Without it the chat politely says it's off.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
ASSISTANT_MODEL=
